# ========================================================
# आपले दादा पोर्टल - मोफत SMTP ईमेल कॉन्फिगरेशन
# ========================================================

# पर्याय १: Gmail SMTP (सर्वात सोपा आणि मोफत)
# १. तुमच्या Google Account मध्ये जा -> Security -> 2-Step Verification चालू करा.
# २. "App Passwords" शोधा -> 'Aaple Dada Portal' नावाने 16 अक्षरी App Password तयार करा.
# ३. खालीलप्रमाणे तुमचा ईमेल आणि तो १६ अक्षरी पासवर्ड टाका:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ज्या ईमेलवर तक्रारींचे नोटिफिकेशन जायला हवे:
NOTIFICATION_RECEIVER=sagareparth@gmail.com

# पर्याय २: Brevo (पूर्वीचे Sendinblue) - 300 मोफत ईमेल्स दररोज
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login
# SMTP_PASSWORD=your_brevo_smtp_key
